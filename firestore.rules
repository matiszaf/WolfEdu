rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function schoolDoc(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId));
    }

    function memberDoc(schoolId) {
      return get(
        /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
      );
    }

    function isOwner(schoolId) {
      return signedIn()
             && schoolDoc(schoolId).data.ownerUid == request.auth.uid;
    }

    function isMember(schoolId) {
      return signedIn() && (
        isOwner(schoolId) ||
        exists(
          /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
        )
      );
    }

    function isAdmin(schoolId) {
      return signedIn() && (
        isOwner(schoolId) ||
        (
          exists(
            /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
          )
          &&
          memberDoc(schoolId).data.role in [
            'owner',
            'admin',
            'director'
          ]
        )
      );
    }


    function isTeacher(schoolId) {
      return signedIn()
             && exists(
               /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
             )
             && memberDoc(schoolId).data.role == 'teacher';
    }

    function isAssignedTeacher(schoolId, teacherId) {
      return isTeacher(schoolId)
             && teacherId is string
             && exists(
               /databases/$(database)/documents/schools/$(schoolId)/teachers/$(teacherId)
             )
             && get(
               /databases/$(database)/documents/schools/$(schoolId)/teachers/$(teacherId)
             ).data.email == request.auth.token.email;
    }


    function linkedPersonExists(schoolId, personType, personId) {
      return personType is string
             && personId is string
             && (
               (
                 personType == 'teacher'
                 && exists(
                   /databases/$(database)/documents/schools/$(schoolId)/teachers/$(personId)
                 )
               )
               ||
               (
                 personType == 'student'
                 && exists(
                   /databases/$(database)/documents/schools/$(schoolId)/students/$(personId)
                 )
               )
               ||
               (
                 personType == 'parent'
                 && exists(
                   /databases/$(database)/documents/schools/$(schoolId)/parents/$(personId)
                 )
               )
             );
    }

    function isSystemAdmin() {
      return signedIn()
             && exists(
               /databases/$(database)/documents/systemAdmins/$(request.auth.uid)
             );
    }

    function isSystemCreator() {
      return isSystemAdmin()
             &&
             get(
               /databases/$(database)/documents/systemAdmins/$(request.auth.uid)
             ).data.role == 'creator';
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{uid} {

      // Użytkownik może czytać własny profil.
      // Creator może odczytać konkretny profil podczas
      // bezpiecznego usuwania szkoły.
      allow get:
        if signedIn()
        && (
          request.auth.uid == uid
          || isSystemCreator()
        );

      allow list: if false;

      allow create:
        if signedIn()
        && (
          request.auth.uid == uid
          ||
          (
            isSystemCreator()
            && request.resource.data.keys().hasOnly(['activeSchoolId'])
            && request.resource.data.activeSchoolId is string
          )
        );

      // Użytkownik zarządza własnym profilem.
      // Creator może zmienić wyłącznie activeSchoolId,
      // np. przy usunięciu szkoły.
      allow update:
        if signedIn()
        && (
          request.auth.uid == uid
          ||
          (
            isSystemCreator()
            && request.resource.data
                 .diff(resource.data)
                 .affectedKeys()
                 .hasOnly(['activeSchoolId'])
          )
        );

      allow delete: if false;
    }


    // =========================================================
    // SCHOOLS
    // =========================================================

    match /schools/{schoolId} {

      // Szkoły może tworzyć wyłącznie creator przez WolfEdu Console.
      allow create:
        if isSystemCreator();

      // Członkowie widzą swoją szkołę.
      // System Admin / Creator widzi wszystkie szkoły.
      allow read:
        if isSystemAdmin()
        || (
          signedIn()
          && (
            resource.data.ownerUid == request.auth.uid
            ||
            exists(
              /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)
            )
          )
        );

      // Admin szkoły może edytować swoją szkołę.
      // System Admin może np. zmieniać systemStatus.
      allow update:
        if isAdmin(schoolId)
        || isSystemAdmin();

      // Trwałe usunięcie szkoły jest operacją systemową
      // dostępną wyłącznie dla roli creator.
      allow delete:
        if isSystemCreator();


      // =======================================================
      // MEMBERS
      // =======================================================

      match /members/{uid} {

        allow read:
          if signedIn()
          && (
            request.auth.uid == uid
            || isAdmin(schoolId)
            || isSystemAdmin()
          );

        // Admin szkoły może dodawać członków bezpośrednio.
        // Zaproszony użytkownik może utworzyć wyłącznie
        // własne członkostwo na podstawie ważnego zaproszenia.
        allow create:
          if isAdmin(schoolId)
          || isSystemAdmin()
          || (
            signedIn()
            && request.auth.uid == uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.inviteId is string

            && exists(
              /databases/$(database)/documents/schoolInvites/$(request.resource.data.inviteId)
            )

            && get(
              /databases/$(database)/documents/schoolInvites/$(request.resource.data.inviteId)
            ).data.schoolId == schoolId

            && get(
              /databases/$(database)/documents/schoolInvites/$(request.resource.data.inviteId)
            ).data.email == request.auth.token.email

            && get(
              /databases/$(database)/documents/schoolInvites/$(request.resource.data.inviteId)
            ).data.role == request.resource.data.role

            && (
              (
                request.resource.data.role in ['admin','director']
                && !('personType' in request.resource.data)
                && !('personId' in request.resource.data)
              )
              ||
              (
                request.resource.data.role in ['teacher','student','parent']

                && get(
                  /databases/$(database)/documents/schoolInvites/$(request.resource.data.inviteId)
                ).data.personType == request.resource.data.personType

                && get(
                  /databases/$(database)/documents/schoolInvites/$(request.resource.data.inviteId)
                ).data.personId == request.resource.data.personId

                && request.resource.data.personType == request.resource.data.role

                && linkedPersonExists(
                  schoolId,
                  request.resource.data.personType,
                  request.resource.data.personId
                )
              )
            )
          );

        // Właściciel szkoły jest chroniony przed przypadkowym
        // usunięciem/degradacją przez szkolnego admina.
        allow update, delete:
          if isSystemCreator()
          || (
            (
              isAdmin(schoolId)
              || isSystemAdmin()
            )
            && uid != schoolDoc(schoolId).data.ownerUid
          );
      }


      // =======================================================
      // CLASSES
      // =======================================================

      match /classes/{docId} {
        allow read:
          if isMember(schoolId)
          || isSystemAdmin();

        allow write:
          if isAdmin(schoolId)
          || isSystemAdmin();
      }


      // =======================================================
      // STUDENTS
      // =======================================================

      match /students/{docId} {
        allow read:
          if isMember(schoolId)
          || isSystemAdmin();

        allow write:
          if isAdmin(schoolId)
          || isSystemAdmin();
      }


      // =======================================================
      // PARENTS
      // =======================================================

      match /parents/{docId} {
        allow read:
          if isMember(schoolId)
          || isSystemAdmin();

        allow write:
          if isAdmin(schoolId)
          || isSystemAdmin();
      }


      // =======================================================
      // TEACHERS
      // =======================================================

      match /teachers/{docId} {
        allow read:
          if isMember(schoolId)
          || isSystemAdmin();

        allow write:
          if isAdmin(schoolId)
          || isSystemAdmin();
      }


      // =======================================================
      // SUBJECTS
      // =======================================================

      match /subjects/{docId} {
        allow read:
          if isMember(schoolId)
          || isSystemAdmin();

        allow write:
          if isAdmin(schoolId)
          || isSystemAdmin();
      }


      // =======================================================
      // TIMETABLE
      // =======================================================

      match /timetable/{docId} {
        allow read:
          if isMember(schoolId)
          || isSystemAdmin();

        allow write:
          if isAdmin(schoolId)
          || isSystemAdmin();
      }


      // =======================================================
      // LESSON RECORDS
      // =======================================================

      match /lessonRecords/{docId} {
        allow read:
          if isMember(schoolId)
          || isSystemAdmin();

        allow create:
          if isAdmin(schoolId)
          || isSystemAdmin()
          || (
            isTeacher(schoolId)

            && request.resource.data.keys().hasOnly([
              'timetableId',
              'date',
              'classId',
              'subjectId',
              'teacherId',
              'teacherUid',
              'lesson',
              'topic',
              'createdAt',
              'createdBy',
              'updatedAt',
              'updatedBy'
            ])

            && request.resource.data.timetableId is string
            && request.resource.data.date is string
            && request.resource.data.classId is string
            && request.resource.data.subjectId is string
            && request.resource.data.teacherId is string
            && request.resource.data.teacherUid == request.auth.uid
            && request.resource.data.lesson is int
            && request.resource.data.topic is string
            && request.resource.data.topic.size() > 0
            && request.resource.data.topic.size() <= 500

            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.updatedBy == request.auth.uid

            && exists(
              /databases/$(database)/documents/schools/$(schoolId)/timetable/$(request.resource.data.timetableId)
            )

            && get(
              /databases/$(database)/documents/schools/$(schoolId)/timetable/$(request.resource.data.timetableId)
            ).data.teacherId == request.resource.data.teacherId

            && get(
              /databases/$(database)/documents/schools/$(schoolId)/timetable/$(request.resource.data.timetableId)
            ).data.classId == request.resource.data.classId

            && get(
              /databases/$(database)/documents/schools/$(schoolId)/timetable/$(request.resource.data.timetableId)
            ).data.subjectId == request.resource.data.subjectId

            && get(
              /databases/$(database)/documents/schools/$(schoolId)/timetable/$(request.resource.data.timetableId)
            ).data.lesson == request.resource.data.lesson

            && isAssignedTeacher(
              schoolId,
              request.resource.data.teacherId
            )
          );

        allow update:
          if isAdmin(schoolId)
          || isSystemAdmin()
          || (
            isTeacher(schoolId)

            && request.resource.data.keys().hasOnly([
              'timetableId',
              'date',
              'classId',
              'subjectId',
              'teacherId',
              'teacherUid',
              'lesson',
              'topic',
              'createdAt',
              'createdBy',
              'updatedAt',
              'updatedBy'
            ])

            && resource.data.teacherUid == request.auth.uid
            && request.resource.data.teacherUid == request.auth.uid
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.timetableId == resource.data.timetableId
            && request.resource.data.classId == resource.data.classId
            && request.resource.data.subjectId == resource.data.subjectId
            && request.resource.data.date == resource.data.date
            && request.resource.data.lesson == resource.data.lesson
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedBy == request.auth.uid

            && request.resource.data.topic is string
            && request.resource.data.topic.size() > 0
            && request.resource.data.topic.size() <= 500

            && isAssignedTeacher(
              schoolId,
              resource.data.teacherId
            )
          );

        allow delete:
          if isAdmin(schoolId)
          || isSystemAdmin();
      }


      // =======================================================
      // ANNOUNCEMENTS
      // =======================================================

      match /announcements/{docId} {
        allow read:
          if isMember(schoolId)
          || isSystemAdmin();

        allow write:
          if isAdmin(schoolId)
          || isSystemAdmin();
      }


      // =======================================================
      // GRADES
      // =======================================================

      match /grades/{docId} {
        allow read:
          if isMember(schoolId)
          || isSystemAdmin();

        allow create:
          if isAdmin(schoolId)
          || isSystemAdmin()
          || (
            isTeacher(schoolId)
            && request.resource.data.teacherId is string
            && isAssignedTeacher(
              schoolId,
              request.resource.data.teacherId
            )
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.updatedBy == request.auth.uid
          );

        allow update:
          if isAdmin(schoolId)
          || isSystemAdmin()
          || (
            isTeacher(schoolId)
            && resource.data.teacherId is string
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedBy == request.auth.uid
            && isAssignedTeacher(
              schoolId,
              resource.data.teacherId
            )
          );

        allow delete:
          if isAdmin(schoolId)
          || isSystemAdmin()
          || (
            isTeacher(schoolId)
            && resource.data.teacherId is string
            && isAssignedTeacher(
              schoolId,
              resource.data.teacherId
            )
          );
      }


      // =======================================================
      // TASKS
      // =======================================================

      match /tasks/{docId} {
        allow read:
          if isMember(schoolId)
          || isSystemAdmin();

        allow create:
          if isAdmin(schoolId)
          || isSystemAdmin()
          || (
            isTeacher(schoolId)
            && request.resource.data.teacherId is string
            && isAssignedTeacher(
              schoolId,
              request.resource.data.teacherId
            )
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.updatedBy == request.auth.uid
          );

        allow update:
          if isAdmin(schoolId)
          || isSystemAdmin()
          || (
            isTeacher(schoolId)
            && resource.data.teacherId is string
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedBy == request.auth.uid
            && isAssignedTeacher(
              schoolId,
              resource.data.teacherId
            )
          );

        allow delete:
          if isAdmin(schoolId)
          || isSystemAdmin()
          || (
            isTeacher(schoolId)
            && resource.data.teacherId is string
            && isAssignedTeacher(
              schoolId,
              resource.data.teacherId
            )
          );
      }


      // =======================================================
      // ATTENDANCE
      // =======================================================

      match /attendance/{docId} {
        allow read:
          if isMember(schoolId)
          || isSystemAdmin();

        allow create:
          if isAdmin(schoolId)
          || isSystemAdmin()
          || (
            isTeacher(schoolId)
            && request.resource.data.teacherId is string
            && isAssignedTeacher(
              schoolId,
              request.resource.data.teacherId
            )
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.updatedBy == request.auth.uid
          );

        allow update:
          if isAdmin(schoolId)
          || isSystemAdmin()
          || (
            isTeacher(schoolId)
            && resource.data.teacherId is string
            && request.resource.data.teacherId == resource.data.teacherId
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedBy == request.auth.uid
            && isAssignedTeacher(
              schoolId,
              resource.data.teacherId
            )
          );

        allow delete:
          if isAdmin(schoolId)
          || isSystemAdmin()
          || (
            isTeacher(schoolId)
            && resource.data.teacherId is string
            && isAssignedTeacher(
              schoolId,
              resource.data.teacherId
            )
          );
      }
    }


    // =========================================================
    // SCHOOL INVITES
    // =========================================================

    match /schoolInvites/{inviteId} {

      allow create:
        if signedIn()
        && request.resource.data.schoolId is string
        && (
          isAdmin(request.resource.data.schoolId)
          || isSystemAdmin()
        )
        && request.resource.data.email is string
        && request.resource.data.role in [
          'admin',
          'director',
          'teacher',
          'parent',
          'student'
        ]

        && (
          (
            request.resource.data.role in ['admin','director']
            && !('personType' in request.resource.data)
            && !('personId' in request.resource.data)
          )
          ||
          (
            request.resource.data.role in ['teacher','parent','student']
            && request.resource.data.personType == request.resource.data.role
            && linkedPersonExists(
              request.resource.data.schoolId,
              request.resource.data.personType,
              request.resource.data.personId
            )
          )
        );

      allow read:
        if signedIn()
        && (
          isSystemAdmin()
          || isAdmin(resource.data.schoolId)
          || resource.data.email == request.auth.token.email
        );

      allow delete:
        if signedIn()
        && (
          isSystemAdmin()
          || isAdmin(resource.data.schoolId)
          || resource.data.email == request.auth.token.email
        );

      allow update: if false;
    }


    // =========================================================
    // RELEASE REQUESTS / OTA
    // =========================================================

    match /releaseRequests/{versionId} {

      // Publiczny odczyt jest celowy:
      // GitHub Actions odczytuje kolejkę przez Firestore REST.
      allow read: if true;

      // Tylko globalny creator może zlecić publikację.
      allow create:
        if isSystemCreator()
        && request.resource.data.keys().hasOnly([
          'versionName',
          'changelog',
          'mandatory',
          'source',
          'createdAt'
        ])
        && request.resource.data.versionName == versionId
        && request.resource.data.versionName.matches(
          '^[0-9]+[.][0-9]+[.][0-9]+$'
        )
        && request.resource.data.changelog is string
        && request.resource.data.changelog.size() > 0
        && request.resource.data.changelog.size() <= 2000
        && request.resource.data.mandatory is bool
        && request.resource.data.source == 'console';

      // Release request pozostaje jako historia.
      allow update, delete: if false;
    }


    // =========================================================
    // SYSTEM ADMINS / WOLFEDU CONSOLE
    // =========================================================

    match /systemAdmins/{uid} {

      // Każdy globalny admin może odczytać listę operatorów.
      allow read:
        if isSystemAdmin();

      // Tylko creator może nadawać lub zmieniać globalne role.
      allow create, update:
        if isSystemCreator()
        && request.resource.data.role in [
          'admin',
          'creator'
        ];

      // Creator może usunąć innego operatora,
      // ale nie może usunąć samego siebie.
      allow delete:
        if isSystemCreator()
        && uid != request.auth.uid;
    }


    // =========================================================
    // LEGACY WOLFSYNC
    // =========================================================

    match /users/{userId}/{document=**} {
      allow read, write:
        if signedIn()
        && request.auth.uid == userId;
    }
  }
}
